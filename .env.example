# Copy to .env.local for local development, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Acquisition analytics.
NEXT_PUBLIC_GA_ID=

# PostHog product analytics. Behaviour analytics (clicks, hovers, scroll, paths).
# Get the Project API Key from PostHog → Project Settings → Project API Key.
# Leave NEXT_PUBLIC_POSTHOG_KEY empty to disable PostHog entirely (no-op).
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. Use the EU cloud (default) or https://us.i.posthog.com for US,
# or your reverse-proxy URL. Must match the region your PostHog project lives in.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
