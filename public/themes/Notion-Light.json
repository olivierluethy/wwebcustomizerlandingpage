{
  "id": "blog-notion-light",
  "name": "Notion Light",
  "source": "wwebcustomizer.com/blog",
  "author": "WhatsApp Web Customizer",
  "vars": {
    "--wc-link": "rgba(9, 127, 232, 1)",
    "--wc-accent": "rgba(9, 127, 232, 1)",
    "--wc-text": "rgba(0, 0, 0, 1)",
    "--wc-receipt": "rgba(9, 127, 232, 1)",
    "--wc-bubble-in": "rgba(255, 255, 255, 1)",
    "--wc-bubble-out": "rgba(240, 239, 237, 1)",
    "--wc-load-main": "linear-gradient(45deg, rgba(246, 245, 244, 1), rgba(234, 233, 232, 1), rgba(246, 245, 244, 1))",
    "--wc-load-side": "linear-gradient(45deg, rgba(246, 245, 244, 1), rgba(234, 233, 232, 1))",
    "--wc-load-item": "linear-gradient(45deg, rgba(250, 249, 248, 1), rgba(235, 234, 233, 1))",
    "--wc-load-item-rev": "linear-gradient(45deg, rgba(235, 234, 233, 1), rgba(250, 249, 248, 1))",
    "--wc-load-item-up": "linear-gradient(to top, rgba(250, 249, 248, 1), rgba(235, 234, 233, 1))",
    "--wc-bg-base": "rgba(255, 255, 255, 1)",
    "--wc-bg-up": "linear-gradient(to top, rgba(242, 242, 242, 1), rgba(255, 255, 255, 1))",
    "--wc-bg-down": "linear-gradient(to bottom, rgba(242, 242, 242, 1), rgba(255, 255, 255, 1))",
    "--wc-bg-diag": "linear-gradient(45deg, rgba(242, 242, 242, 1), rgba(255, 255, 255, 1))",
    "--wc-bg-diag-alt": "linear-gradient(45deg, rgba(255, 255, 255, 1), rgba(242, 242, 242, 1))",
    "--wc-scroll": "rgba(209, 209, 209, 1)"
  }
}
