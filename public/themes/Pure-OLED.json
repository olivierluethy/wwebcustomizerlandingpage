{
  "id": "blog-pure-oled",
  "name": "Pure OLED",
  "source": "wwebcustomizer.com/blog",
  "author": "WhatsApp Web Customizer",
  "vars": {
    "--wc-link": "rgba(37, 211, 102, 1)",
    "--wc-accent": "rgba(37, 211, 102, 1)",
    "--wc-text": "rgba(230, 230, 230, 1)",
    "--wc-receipt": "rgba(37, 211, 102, 1)",
    "--wc-bubble-in": "rgba(10, 10, 10, 1)",
    "--wc-bubble-out": "rgba(13, 59, 46, 1)",
    "--wc-load-main": "linear-gradient(45deg, rgba(5, 5, 5, 1), rgba(4, 4, 4, 1), rgba(5, 5, 5, 1))",
    "--wc-load-side": "linear-gradient(45deg, rgba(5, 5, 5, 1), rgba(4, 4, 4, 1))",
    "--wc-load-item": "linear-gradient(45deg, rgba(3, 3, 3, 1), rgba(18, 18, 18, 1))",
    "--wc-load-item-rev": "linear-gradient(45deg, rgba(18, 18, 18, 1), rgba(3, 3, 3, 1))",
    "--wc-load-item-up": "linear-gradient(to top, rgba(3, 3, 3, 1), rgba(18, 18, 18, 1))",
    "--wc-bg-base": "rgba(0, 0, 0, 1)",
    "--wc-bg-up": "linear-gradient(to top, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-down": "linear-gradient(to bottom, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-diag": "linear-gradient(45deg, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-diag-alt": "linear-gradient(45deg, rgba(0, 0, 0, 1), rgba(13, 13, 13, 1))",
    "--wc-scroll": "rgba(41, 41, 41, 1)"
  }
}
