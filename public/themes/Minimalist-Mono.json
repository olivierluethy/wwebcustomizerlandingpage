{
  "id": "blog-minimalist-mono",
  "name": "Minimalist Mono",
  "source": "wwebcustomizer.com/blog",
  "author": "WhatsApp Web Customizer",
  "vars": {
    "--wc-link": "rgba(74, 85, 104, 1)",
    "--wc-accent": "rgba(74, 85, 104, 1)",
    "--wc-text": "rgba(30, 30, 30, 1)",
    "--wc-receipt": "rgba(74, 85, 104, 1)",
    "--wc-bubble-in": "rgba(239, 239, 239, 1)",
    "--wc-bubble-out": "rgba(225, 227, 230, 1)",
    "--wc-load-main": "linear-gradient(45deg, rgba(240, 240, 241, 1), rgba(228, 228, 229, 1), rgba(240, 240, 241, 1))",
    "--wc-load-side": "linear-gradient(45deg, rgba(240, 240, 241, 1), rgba(228, 228, 229, 1))",
    "--wc-load-item": "linear-gradient(45deg, rgba(244, 244, 245, 1), rgba(229, 229, 230, 1))",
    "--wc-load-item-rev": "linear-gradient(45deg, rgba(229, 229, 230, 1), rgba(244, 244, 245, 1))",
    "--wc-load-item-up": "linear-gradient(to top, rgba(244, 244, 245, 1), rgba(229, 229, 230, 1))",
    "--wc-bg-base": "rgba(250, 250, 250, 1)",
    "--wc-bg-up": "linear-gradient(to top, rgba(238, 238, 238, 1), rgba(250, 250, 250, 1))",
    "--wc-bg-down": "linear-gradient(to bottom, rgba(238, 238, 238, 1), rgba(250, 250, 250, 1))",
    "--wc-bg-diag": "linear-gradient(45deg, rgba(238, 238, 238, 1), rgba(250, 250, 250, 1))",
    "--wc-bg-diag-alt": "linear-gradient(45deg, rgba(250, 250, 250, 1), rgba(238, 238, 238, 1))",
    "--wc-scroll": "rgba(210, 210, 210, 1)"
  }
}
