{
  "id": "blog-oled-black",
  "name": "OLED Black",
  "source": "wwebcustomizer.com/blog",
  "author": "WhatsApp Web Customizer",
  "vars": {
    "--wc-link": "rgba(37, 211, 102, 1)",
    "--wc-accent": "rgba(37, 211, 102, 1)",
    "--wc-text": "rgba(224, 224, 224, 1)",
    "--wc-receipt": "rgba(37, 211, 102, 1)",
    "--wc-bubble-in": "rgba(15, 15, 15, 1)",
    "--wc-bubble-out": "rgba(20, 77, 55, 1)",
    "--wc-load-main": "linear-gradient(45deg, rgba(10, 10, 10, 1), rgba(9, 9, 9, 1), rgba(10, 10, 10, 1))",
    "--wc-load-side": "linear-gradient(45deg, rgba(10, 10, 10, 1), rgba(9, 9, 9, 1))",
    "--wc-load-item": "linear-gradient(45deg, rgba(6, 6, 6, 1), rgba(21, 21, 21, 1))",
    "--wc-load-item-rev": "linear-gradient(45deg, rgba(21, 21, 21, 1), rgba(6, 6, 6, 1))",
    "--wc-load-item-up": "linear-gradient(to top, rgba(6, 6, 6, 1), rgba(21, 21, 21, 1))",
    "--wc-bg-base": "rgba(0, 0, 0, 1)",
    "--wc-bg-up": "linear-gradient(to top, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-down": "linear-gradient(to bottom, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-diag": "linear-gradient(45deg, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-diag-alt": "linear-gradient(45deg, rgba(0, 0, 0, 1), rgba(13, 13, 13, 1))",
