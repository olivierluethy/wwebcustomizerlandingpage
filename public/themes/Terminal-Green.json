{
  "id": "blog-terminal-green",
  "name": "Terminal Green",
  "source": "wwebcustomizer.com/blog",
  "author": "WhatsApp Web Customizer",
  "vars": {
    "--wc-link": "rgba(51, 255, 51, 1)",
    "--wc-accent": "rgba(51, 255, 51, 1)",
    "--wc-text": "rgba(51, 255, 51, 1)",
    "--wc-receipt": "rgba(51, 255, 51, 1)",
    "--wc-bubble-in": "rgba(15, 26, 15, 1)",
    "--wc-bubble-out": "rgba(26, 58, 26, 1)",
    "--wc-load-main": "linear-gradient(45deg, rgba(15, 26, 15, 1), rgba(13, 22, 13, 1), rgba(15, 26, 15, 1))",
