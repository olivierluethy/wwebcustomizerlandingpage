{
  "id": "blog-monochrome-oled",
  "name": "Monochrome OLED",
  "source": "wwebcustomizer.com/blog",
  "author": "WhatsApp Web Customizer",
  "vars": {
    "--wc-link": "rgba(176, 176, 176, 1)",
    "--wc-accent": "rgba(176, 176, 176, 1)",
    "--wc-text": "rgba(240, 240, 240, 1)",
    "--wc-receipt": "rgba(176, 176, 176, 1)",
    "--wc-bubble-in": "rgba(12, 12, 12, 1)",
    "--wc-bubble-out": "rgba(28, 28, 28, 1)",
    "--wc-load-main": "linear-gradient(45deg, rgba(8, 8, 8, 1), rgba(7, 7, 7, 1), rgba(8, 8, 8, 1))",
    "--wc-load-side": "linear-gradient(45deg, rgba(8, 8, 8, 1), rgba(7, 7, 7, 1))",
    "--wc-load-item": "linear-gradient(45deg, rgba(5, 5, 5, 1), rgba(20, 20, 20, 1))",
    "--wc-load-item-rev": "linear-gradient(45deg, rgba(20, 20, 20, 1), rgba(5, 5, 5, 1))",
    "--wc-load-item-up": "linear-gradient(to top, rgba(5, 5, 5, 1), rgba(20, 20, 20, 1))",
    "--wc-bg-base": "rgba(0, 0, 0, 1)",
    "--wc-bg-up": "linear-gradient(to top, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-down": "linear-gradient(to bottom, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-diag": "linear-gradient(45deg, rgba(13, 13, 13, 1), rgba(0, 0, 0, 1))",
    "--wc-bg-diag-alt": "linear-gradient(45deg, rgba(0, 0, 0, 1), rgba(13, 13, 13, 1))",
    "--wc-scroll": "rgba(43, 43, 43, 1)"
  }
}
