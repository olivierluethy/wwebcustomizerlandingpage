{
  "id": "blog-linear-dark",
  "name": "Linear Dark",
  "source": "wwebcustomizer.com/blog",
  "author": "WhatsApp Web Customizer",
  "vars": {
    "--wc-link": "rgba(94, 106, 210, 1)",
    "--wc-accent": "rgba(94, 106, 210, 1)",
    "--wc-text": "rgba(230, 230, 231, 1)",
    "--wc-receipt": "rgba(94, 106, 210, 1)",
    "--wc-bubble-in": "rgba(21, 22, 25, 1)",
    "--wc-bubble-out": "rgba(28, 29, 33, 1)",
    "--wc-load-main": "linear-gradient(45deg, rgba(8, 9, 10, 1), rgba(7, 8, 9, 1), rgba(8, 9, 10, 1))",
    "--wc-load-side": "linear-gradient(45deg, rgba(8, 9, 10, 1), rgba(7, 8, 9, 1))",
    "--wc-load-item": "linear-gradient(45deg, rgba(10, 11, 12, 1), rgba(25, 26, 27, 1))",
    "--wc-load-item-rev": "linear-gradient(45deg, rgba(25, 26, 27, 1), rgba(10, 11, 12, 1))",
    "--wc-load-item-up": "linear-gradient(to top, rgba(10, 11, 12, 1), rgba(25, 26, 27, 1))",
    "--wc-bg-base": "rgba(13, 14, 16, 1)",
    "--wc-bg-up": "linear-gradient(to top, rgba(25, 26, 28, 1), rgba(13, 14, 16, 1))",
    "--wc-bg-down": "linear-gradient(to bottom, rgba(25, 26, 28, 1), rgba(13, 14, 16, 1))",
    "--wc-bg-diag": "linear-gradient(45deg, rgba(25, 26, 28, 1), rgba(13, 14, 16, 1))",
    "--wc-bg-diag-alt": "linear-gradient(45deg, rgba(13, 14, 16, 1), rgba(25, 26, 28, 1))",
    "--wc-scroll": "rgba(52, 53, 55, 1)"
  }
}
